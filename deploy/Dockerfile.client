#
# A JDBC client that authenticates with Kerberos, for testing the gateway.
#
# Built the same way as the gateway - Maven against the laptop's ~/.m2 - so it
# uses the driver the project already resolves rather than a downloaded one.

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY . .
RUN --mount=type=bind,from=m2,target=/root/.m2,rw \
    mvn -B -o -pl kyuubi-hive-jdbc \
        -DskipTests -Dmaven.test.skip=true \
        -Dspotless.check.skip=true -Dscalastyle.skip=true -Drat.skip=true \
        package dependency:copy-dependencies \
        -DoutputDirectory=/runtime/lib -DincludeScope=runtime && \
    cp kyuubi-hive-jdbc/target/kyuubi-hive-jdbc-*.jar /runtime/lib/ && \
    javac -cp "/runtime/lib/*" -d /runtime deploy/client/Probe.java

FROM eclipse-temurin:17-jre
COPY --from=build /runtime /opt/probe
# A JRE rather than distroless: this is a test client, and being able to open a
# shell in it when a Kerberos exchange fails is worth more here than the few
# megabytes.
ENTRYPOINT ["java", "-cp", "/opt/probe:/opt/probe/lib/*", "Probe"]
