# Compose build tags / published image refs for system-tests.

# Built by compose from Dockerfile.spark3-scala213 (Scala 2.13).
SPARK3_IMAGE=local/spark:3.5.5-scala2.13
SPARK4_IMAGE=apache/spark:4.0.1
# Metastore / Trino catalog (stable with Trino 435)
HIVE_IMAGE=apache/hive:3.1.3
# Client HIVE_HOME baked into Kyuubi image (Hive 4 SessionManager API)
HIVE_HOME_IMAGE=apache/hive:4.0.1

POSTGRES_VERSION=15
ZOOKEEPER_VERSION=3.9
TRINO_VERSION=435

POSTGRES_JDBC_VERSION=42.7.3
MAVEN_CENTRAL=https://repo1.maven.org/maven2
KYUUBI_BASE_IMAGE=eclipse-temurin:17-jdk-jammy

KYUUBI_IMAGE_TAG=system-tests
