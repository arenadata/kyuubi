# Spark 3.5.4 with Scala 2.13 (official apache/spark:3.5.4 is Scala 2.12).
# Built by compose (spark3-master/worker). Image tag: SPARK3_IMAGE in env/.env.

ARG BASE_IMAGE=eclipse-temurin:17-jdk-jammy
ARG SPARK3_TGZ_URL=https://archive.apache.org/dist/spark/spark-3.5.4/spark-3.5.4-bin-hadoop3-scala2.13.tgz

FROM ${BASE_IMAGE}

ARG SPARK3_TGZ_URL

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl bash tini procps \
 && rm -rf /var/lib/apt/lists/*

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${PATH}"

RUN echo "Downloading ${SPARK3_TGZ_URL}" \
 && curl -fL --retry 3 --retry-delay 5 --connect-timeout 30 \
      -o /tmp/spark.tgz "${SPARK3_TGZ_URL}" \
 && tar -xzf /tmp/spark.tgz -C /opt \
 && rm /tmp/spark.tgz \
 && mv /opt/spark-3.5.4-bin-hadoop3-scala2.13 /opt/spark

WORKDIR /opt/spark
